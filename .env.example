# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Anthropic API key for invoice vision extraction (console.anthropic.com)
ANTHROPIC_API_KEY=""

# Supabase Storage, for the scanned invoice images shown in the Review UI.
# Project Settings -> API -> Project URL / service_role key. Create a
# PUBLIC bucket matching SUPABASE_BUCKET in the Supabase dashboard first.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="invoice-scans"

# Simple shared-secret auth for the family (Phase 1 — see README "Security")
AUTH_SECRET=""
