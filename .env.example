# Supabase Postgres connection strings (Project Settings -> Database -> Connection string).
# DATABASE_URL uses the Transaction pooler (port 6543, ?pgbouncer=true) so many
# short-lived queries share a small number of real connections instead of each
# one holding its own session-mode slot -- Supabase's session-mode pooler
# (port 5432) hard-caps at 15 total connections project-wide and gets
# exhausted quickly by ordinary concurrent app traffic.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# DIRECT_URL uses the Session pooler (port 5432) and is only used by
# `prisma migrate` — advisory locks and other session-level features aren't
# available through the transaction pooler.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Anthropic API key for invoice vision extraction (console.anthropic.com)
ANTHROPIC_API_KEY=""

# Supabase Storage, for the scanned invoice images shown in the Review UI.
# Project Settings -> API -> Project URL / service_role key. Create a
# PUBLIC bucket matching SUPABASE_BUCKET in the Supabase dashboard first.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="invoice-scans"

# Simple shared-secret auth for the family (Phase 1 — see README "Security")
AUTH_SECRET=""

# Lets an unattended external client (e.g. the scanner watcher script on
# another computer, scripts/scan-uploader/) upload without a browser login
# session. Separate from AUTH_SECRET so it can be rotated on its own, e.g.
# `openssl rand -hex 32`. Leave unset to disable unattended uploads entirely.
UPLOAD_API_TOKEN=""
