# Copy this file to ~/.flowerman-scan-uploader.env on the scanning
# computer and fill in the values below (see README.md in this directory).

# Folder your scanner software saves finished scans to.
WATCH_DIR="$HOME/Scans"

# Successfully-uploaded files are moved here (timestamped, never
# overwritten) instead of staying in WATCH_DIR or being deleted.
UPLOADED_DIR="$HOME/Scans/uploaded"

# Files that failed to upload are moved here so they don't get retried
# forever and silently clutter WATCH_DIR — check this folder if invoices
# seem to be going missing.
FAILED_DIR="$HOME/Scans/failed"

# The deployed FLOWER MAN app's base URL, no trailing slash.
APP_URL="https://your-app.vercel.app"

# Must match UPLOAD_API_TOKEN in the app's own environment variables.
UPLOAD_TOKEN=""

# How many seconds a file must sit untouched before it's considered done
# being written. Raise this if your scanner is slow to finish a multi-page
# scan and files sometimes get uploaded mid-write.
MIN_AGE_SECONDS=10

# Where this script logs its own activity (separate from launchd's
# stdout/stderr logs set in the .plist).
LOG_FILE="$HOME/Library/Logs/flowerman-scan-uploader.log"
