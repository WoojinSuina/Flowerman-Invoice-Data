// FLOWER MAN — Prisma schema
// All money fields are stored as integer CENTS (never float) to avoid
// rounding drift. Convert to display decimals only in the UI layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction-mode pooler (port 6543) — many short-lived queries share a
  // small number of real Postgres connections, instead of each Prisma
  // connection holding its own session-mode slot. Session-mode (port 5432,
  // 15-connection hard cap on Supabase) was getting exhausted by ordinary
  // concurrent queries during a batch upload.
  url       = env("DATABASE_URL")
  // Session-mode connection, used only for schema migrations (advisory
  // locks and other session-level features aren't available through a
  // transaction pooler).
  directUrl = env("DIRECT_URL")
}

enum ValidationStatus {
  PROCESSING
  PASS
  REVIEW
  APPROVED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model Store {
  id          String   @id @default(uuid())
  // Identity is (storeNumber, brand word of name) together — see
  // lib/invoices/processInvoicePage.ts's resolveStore() and
  // lib/stores.ts's extractBrand(). Not a DB-level unique constraint:
  // brand is derived from name (its first word), not its own column, and
  // the printed number alone has been confirmed, on real data, to get
  // reused across different real brands at different points — adding a
  // bare @unique on storeNumber would either reject that legitimate reuse
  // or require resolving every historical collision by hand first.
  // name/address are display info, resynced to the latest extraction on
  // every match.
  storeNumber String   @map("store_number")
  name        String
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoices Invoice[]

  @@map("stores")
}

// Canonical product dictionary — products are NOT hardcoded into logic,
// this table just dedupes names seen across invoices for analytics.
model Product {
  id        String   @id @default(uuid())
  name      String   @unique
  // What FLOWER MAN pays per unit (wholesale/production cost), set by hand
  // per product — null until someone sets it, since it isn't in the
  // invoice data anywhere. Used to turn revenue into actual profit.
  costCents Int?     @map("cost_cents")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoiceItems InvoiceItem[]

  @@map("products")
}

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @map("invoice_number")
  invoiceDate   DateTime @map("invoice_date")

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id])

  // As printed/written on the invoice
  totalChargesCents    Int @map("total_charges_cents")
  totalCreditCents      Int @map("total_credit_cents")
  totalAmountDueCents   Int @map("total_amount_due_cents")

  // Independently computed by the validation engine
  calculatedTotalChargesCents  Int @map("calculated_total_charges_cents")
  calculatedTotalCreditCents   Int @map("calculated_total_credit_cents")
  calculatedAmountDueCents     Int @map("calculated_amount_due_cents")

  validationDifferenceCents Int              @map("validation_difference_cents")
  validationStatus          ValidationStatus @default(PROCESSING) @map("validation_status")
  validationSuggestions     Json?            @map("validation_suggestions") // array of suggestion strings

  // Set at ingestion when another invoice at the same store, same date, and
  // same total amount due already exists (but with a different invoice
  // number — an exact number match is rejected outright by the unique
  // constraint below). Catches a re-scan that OCR reads slightly
  // differently. Plain id, no relation — looked up manually when needed,
  // same pattern as Store/Product joins elsewhere in this app.
  possibleDuplicateOfId String? @map("possible_duplicate_of_id")

  // Raw AI output, preserved forever, never overwritten
  rawExtraction Json? @map("raw_extraction")

  sourceFile     String  @map("source_file")
  sourcePage     Int     @map("source_page")
  sourceImageUrl String? @map("source_image_url")

  processingJobId String?        @map("processing_job_id")
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  approvedAt DateTime? @map("approved_at")

  // Set only when APPROVED came from a bulk tolerance action (e.g. "approve
  // everything under $5 difference") rather than a human actually opening
  // this invoice and clicking Approve. Null means either not approved, or
  // approved after a real look — lets a later audit pull up exactly the
  // ones nobody's eyes have actually been on. See lib/reviewFilters.ts.
  autoApprovedReason String? @map("auto_approved_reason")

  // Set at ingestion when this invoice matched an existing Store by
  // (storeNumber, brand) — see resolveStore() — but its address didn't
  // look like the address already on file for that store. Forces REVIEW
  // the same as a possible duplicate or a future date: brand+number isn't
  // a perfect identity (the same number has been reused across different
  // real locations of the same brand before), so an address that looks
  // unfamiliar needs a human to confirm this wasn't actually a different
  // store. Null means either no existing store matched (new store, no
  // address history to compare against) or the address matched fine.
  addressMismatchNote String? @map("address_mismatch_note")

  items               InvoiceItem[]
  manualCorrections   ManualCorrection[]
  extractionAttempts  ExtractionAttempt[]

  @@unique([invoiceNumber, storeId], name: "uniq_invoice_per_store")
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   String? @map("product_id")
  product     Product? @relation(fields: [productId], references: [id])
  productName String  @map("product_name") // denormalized snapshot at time of invoice

  lineNumber Int @default(0) @map("line_number") // stable position for ManualCorrection.fieldPath addressing

  retailPriceCents Int @map("retail_price_cents")
  unitCostCents    Int @map("unit_cost_cents")

  deliveredQuantity Int @map("delivered_quantity")
  returnedQuantity  Int @map("returned_quantity")
  soldQuantity      Int @map("sold_quantity") // = delivered - returned, stored for query speed

  deliveredAmountCents Int @map("delivered_amount_cents") // delivered * unitCost
  returnCreditCents    Int @map("return_credit_cents")     // returned * unitCost
  netSoldAmountCents   Int @map("net_sold_amount_cents")   // sold * unitCost

  confidence Float? // 0-1, from AI extraction, especially for handwritten fields

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoice_items")
}

// One row per AI extraction call. Lets us audit how well the model performs
// over time and re-run extraction without losing history.
model ExtractionAttempt {
  id        String  @id @default(uuid())
  invoiceId String? @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  processingJobId String?        @map("processing_job_id")
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id])
  sourcePage      Int?           @map("source_page") // set for batch pages, esp. failed ones with no Invoice row

  provider     String // e.g. "claude-vision"
  rawResponse  Json   @map("raw_response")
  succeeded    Boolean
  errorMessage String? @map("error_message")
  // Set only when the file was already uploaded to storage before the
  // failure happened (e.g. a duplicate rejected at the DB write) so a failed
  // page can still be viewed — never set when upload itself failed.
  sourceImageUrl String? @map("source_image_url")
  // Set when this failure was a hard duplicate rejection (unique constraint
  // on invoiceNumber+storeId) — points at the invoice it collided with, so
  // the failed scan can be shown side by side with the one already on file.
  // Plain id, no relation, same pattern as Invoice.possibleDuplicateOfId.
  duplicateOfInvoiceId String? @map("duplicate_of_invoice_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("extraction_attempts")
}

// Every human edit to an extracted field, for audit trail (§8, §16)
model ManualCorrection {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  fieldPath     String @map("field_path") // e.g. "items[0].returnedQuantity"
  originalValue String @map("original_value")
  correctedValue String @map("corrected_value")
  correctedBy   String? @map("corrected_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("manual_corrections")
}

model ProcessingJob {
  id             String    @id @default(uuid())
  filename       String
  totalPages     Int       @map("total_pages")
  processedPages Int       @default(0) @map("processed_pages")
  passedPages    Int       @default(0) @map("passed_pages")
  reviewPages    Int       @default(0) @map("review_pages")
  failedPages    Int       @default(0) @map("failed_pages")
  status         JobStatus @default(PENDING)

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  invoices           Invoice[]
  extractionAttempts ExtractionAttempt[]
  pendingPages       PendingPage[]

  @@map("processing_jobs")
}

// A page that has been uploaded to Storage but not yet run through Claude
// extraction. Upload is split into two steps specifically so the upload
// request itself stays fast (just splitting a PDF and storing bytes, no
// Vision API calls) — Vercel's serverless functions have a timeout that a
// single request extracting every page of a large PDF would blow through,
// and a slow request is also what made refreshing/closing the tab mid-batch
// lose work. Extraction happens later, one row at a time, via a
// self-chaining background process (see app/api/jobs/process-next).
model PendingPage {
  id              String        @id @default(uuid())
  processingJobId String        @map("processing_job_id")
  processingJob   ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)

  sourcePage     Int    @map("source_page") // 1-based, matches Invoice.sourcePage
  sourceFileName String @map("source_file_name")
  storageUrl     String @map("storage_url")
  mimeType       String @map("mime_type")

  // Set when a chain link claims this row, cleared never — a row is deleted
  // once actually processed. A claimedAt older than a few minutes is treated
  // as abandoned (e.g. the function crashed mid-Claude-call) and reclaimed,
  // so one bad page can't stall the whole queue forever.
  claimedAt DateTime? @map("claimed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("pending_pages")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") // "invoice", "invoice_item", etc.
  entityId   String   @map("entity_id")
  action     String   // "created", "approved", "corrected", "status_changed"
  detail     Json?
  actor      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
